# Copy this file, fill it in and pass it with: docker run --env-file
# Anything ending in .env is ignored by git: never commit the real key.

# --- IT Glue -----------------------------------------------------------------
ENVIRONMENT_ITGLUE=api.eu.itglue.com
ENVIRONMENT_ITGLUE_APIKEY=ITG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENVIRONMENT_ITGLUE_CONFIGURATION_STATUS_ACTIVE=0
ENVIRONMENT_ITGLUE_FLEXIBLE_ASSET_TYPE_ID=0

# --- FortiCare ---------------------------------------------------------------
ENVIRONMENT_FORTINET_USERNAME=
ENVIRONMENT_FORTINET_PASSWORD=
ENVIRONMENT_FORTINET_CLIENTID=assetmanagement

# --- FortiAnalyzer -----------------------------------------------------------
ENVIRONMENT_FORTIANALYZER_FQDN=
ENVIRONMENT_FORTIANALYZER_USERNAME=
ENVIRONMENT_FORTIANALYZER_PASSWORD=
ENVIRONMENT_FORTIANALYZER_FOLDER=IBS
ENVIRONMENT_FORTIANALYZER_EMAIL_FROM=
ENVIRONMENT_FORTIANALYZER_EMAIL_SMTP=

# --- Optional ----------------------------------------------------------------
# Rehearsal: log every change without sending a single call that writes.
# ENVIRONMENT_DRYRUN=1
# Skip one of the two stages.
# ENVIRONMENT_FORTINET_NOSYNC=1
# ENVIRONMENT_FORTIANALYZER_NOREPORT=1
# Work on some ADOMs only, useful for a staged rollout.
# ENVIRONMENT_FORTIANALYZER_ADOM=root
# Verify the appliance certificate against this bundle. It has to be the
# authority that signed the certificate of the appliance: the system bundle
# will not do for the self signed certificate an appliance carries by default.
# ENVIRONMENT_FORTIANALYZER_CACERT=/ca/fortianalyzer.crt
# ENVIRONMENT_LOG_LEVEL=debug
